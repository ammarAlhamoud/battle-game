{
  "name": "eightfold-rts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "tsc --noEmit",
    "test:browser": "node scripts/qa-browser.mjs",
    "test:localization": "node scripts/qa-localization.mjs",
    "test:art": "node scripts/qa-art.mjs",
    "test:storage": "node scripts/qa-storage.mjs",
    "test:campaign": "node scripts/simulate-campaign.mjs",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "test:tactics": "node scripts/qa-tactics.mjs",
    "test:runtime": "node scripts/qa-runtime.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
